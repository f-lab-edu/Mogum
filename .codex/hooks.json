{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/tdd_guard.py\" pre",
            "statusMessage": "TDD 가드"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/tdd_guard.py\" stop",
            "statusMessage": "TDD 가드"
          }
        ]
      }
    ]
  }
}
