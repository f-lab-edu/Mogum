# 로컬 백엔드 환경 변수 — 이 파일을 .env 로 복사해 값을 채운다(.env 는 커밋하지 않는다).
#   cp .env.example .env
#   docker compose up -d --build     # 서버 컨테이너 — compose 가 이 .env 를 서버에 넘긴다(DB_URL 은 compose 가 덮어쓴다)
# 또는 호스트에서 직접:
#   set -a; source .env; set +a      # 저장소 루트에서
#   cd backend && ./gradlew bootRun
# 이름과 기본값은 backend/src/main/resources/application.yml 이 출처다(설명은 docs/05-api.md §1.1).

# 구글 OAuth 클라이언트 — 없거나 비어 있으면 기동을 거부한다.
# Google Cloud Console → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)
# 승인된 리디렉션 URI: http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 로그인을 허용할 관리자 이메일(쉼표로 구분). 비어 있으면 아무도 로그인하지 못한다(ADR-062).
APP_AUTH_ADMIN_EMAILS=

# 아래는 로컬 기본값이 있어 비워 두면 된다 — 바꿀 때만 주석을 푼다.
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# APP_WEB_ORIGIN=http://localhost:5173
# APP_WEB_COOKIE_DOMAIN=
# DB_URL=jdbc:postgresql://localhost:5432/mogum
# DB_USERNAME=mogum_local
# DB_PASSWORD=mogum_local
