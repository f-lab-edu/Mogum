# /etc/mogum/mogum.env — root 소유 · 권한 600. 릴리스 밖에서 관리한다.
# APP_IMAGE는 app-image.ref를 검증한 deploy.sh가 지정하므로 여기에 두지 않는다.
API_DOMAIN=api.{도메인}
DB_USERNAME=
DB_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.{도메인}/auth/google/callback
APP_WEB_ORIGIN=https://{도메인}
APP_WEB_COOKIE_DOMAIN={도메인}
APP_AUTH_ADMIN_EMAILS=
# 백업(backups/)과 배포 묶음(releases/)이 공유하는 S3 버킷. 인스턴스 역할로 접근한다.
MOGUM_BUCKET=
